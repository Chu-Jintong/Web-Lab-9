
@model UniversityProject_2.Models.Student
@using System.Web.Mvc

@{
    ViewBag.Title = "Create";
}

<h2>Create Student</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Student</h4>
        <hr />

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger" }
        )

        <!-- Student Name -->
        <div class="form-group">
            @Html.LabelFor(
                model => model.Name,
                "Student Name",
                new { @class = "control-label col-md-2" }
            )

            <div class="col-md-10">
                @Html.EditorFor(
                    model => model.Name,
                    new { htmlAttributes = new { @class = "form-control" } }
                )

                @Html.ValidationMessageFor(
                    model => model.Name,
                    "",
                    new { @class = "text-danger" }
                )
            </div>
        </div>

        <!-- Student Address -->
        <div class="form-group">
            @Html.LabelFor(
                model => model.Address,
                "Student Address",
                new { @class = "control-label col-md-2" }
            )

            <div class="col-md-10">
                @Html.EditorFor(
                    model => model.Address,
                    new { htmlAttributes = new { @class = "form-control" } }
                )

                @Html.ValidationMessageFor(
                    model => model.Address,
                    "",
                    new { @class = "text-danger" }
                )
            </div>
        </div>

        <!-- Campus Dropdown List -->
        <div class="form-group">
            @Html.LabelFor(
                model => model.CampusID,
                "Campus",
                new { @class = "control-label col-md-2" }
            )

            <div class="col-md-10">
                @Html.DropDownListFor(
                    model => model.CampusID,
                    (IEnumerable<SelectListItem>)ViewBag.CampusList,
                    "-- Select Campus --",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(
                    model => model.CampusID,
                    "",
                    new { @class = "text-danger" }
                )
            </div>
        </div>

        <!-- Create Button -->
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit"
                       value="Create"
                       class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
